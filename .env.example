# free-web-search-mcp environment variables.
# Copy to `.env` (gitignored) and fill in any overrides.

# --- Provider API keys (composed; both optional, DDG needs none) -----------
# Tavily: get one at https://app.tavily.com (~1,000 credits/month free).
TAVILY_API_KEY=
# Firecrawl: get one at https://firecrawl.dev (~1,000 credits/month free).
FIRECRAWL_API_KEY=

# --- Transport (Streamable HTTP vs stdio) ---------------------------------
FWS_TRANSPORT=http
FWS_HOST=127.0.0.1
FWS_PORT=8000
FWS_PATH=/mcp

# --- Cross-provider --------------------------------------------------------
FWS_CACHE_DIR=./cache/fws
FWS_HTTP_TIMEOUT_S=30.0

# --- Logging ---------------------------------------------------------------
# Server-level logger; MCP_LOG_LEVEL and FASTMCP_LOG_LEVEL are honoured as fallbacks.
FWS_LOG_LEVEL=WARNING

# --- DDG -------------------------------------------------------------------
FWS_DDG_ENABLED=1
FWS_DDG_CACHE_TTL_SECS=86400
FWS_DDG_MIN_INTERVAL_MS=1100

# --- Tavily ----------------------------------------------------------------
# When TAVILY_API_KEY is empty, the Tavily adapter is not registered.
FWS_TAVILY_ENABLED=1
FWS_TAVILY_CACHE_TTL_SECS=86400
FWS_TAVILY_MIN_INTERVAL_MS=200
FWS_TAVILY_MAX_CALLS=200
FWS_TAVILY_MAX_RAW_CHARS=8000

# --- Firecrawl -------------------------------------------------------------
# When FIRECRAWL_API_KEY is empty, the Firecrawl adapter is not registered.
FWS_FIRECRAWL_ENABLED=1
FWS_FIRECRAWL_CACHE_TTL_SECS=86400
FWS_FIRECRAWL_MIN_INTERVAL_MS=0
FWS_FIRECRAWL_MIN_CREDITS=50
FWS_FIRECRAWL_MAX_MARKDOWN_CHARS=8000
